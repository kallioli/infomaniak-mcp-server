{
  "name": "infomaniak-mcp-server",
  "version": "0.1.0",
  "description": "Remote MCP server exposing the full Infomaniak API",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:server && npm run build:admin",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "catalog": "tsx scripts/build-catalog.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p admin-ui/tsconfig.json",
    "test": "vitest run",
    "build:server": "tsc -p tsconfig.json && cp src/catalog.json dist/catalog.json",
    "build:admin": "tsc -p admin-ui/tsconfig.json && vite build",
    "dev:admin": "vite",
    "extensions:sanitize": "tsx scripts/sanitize-extensions.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
