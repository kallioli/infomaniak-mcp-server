# HTTP listener
PORT=3000
HOST=0.0.0.0

# Persistent data (SQLite database: connections, MCP tokens, settings). Mount a volume here.
DATA_DIR=./data
# Key encrypting the stored Infomaniak tokens (>= 32 chars). If unset, one is generated in
# DATA_DIR/secret.key: back it up, stored tokens cannot be decrypted without it.
# MCP_SECRET_KEY=

# Admin portal (separate port, keep it private: do not publish it through the public proxy)
ADMIN_ENABLED=true
ADMIN_PORT=9090
# ADMIN_HOST=0.0.0.0
# Sets/resets the admin password at startup (>= 12 chars). If unset, the first launch runs
# an onboarding wizard in the portal, unlocked by a one-time setup code printed in the logs.
# ADMIN_PASSWORD=

# Everything below can instead be configured in the portal (stored in the database, applied
# without restart). A variable set here takes precedence and locks the field in the portal.

# Public URL of this server, as seen by clients (required for OAuth)
# PUBLIC_URL=https://mcp.example.com

# OAuth "Sign in with Infomaniak" (recommended for claude.ai and other OAuth-capable clients).
# Create an OAuth application at Infomaniak with redirect URI ${PUBLIC_URL}/oauth/callback.
# INFOMANIAK_OAUTH_CLIENT_ID=
# INFOMANIAK_OAUTH_CLIENT_SECRET=
# Random secret (>= 32 chars) sealing OAuth clients, codes and tokens. Optional: generated and
# stored (encrypted) in the database when unset. Rotating it signs every OAuth user out.
# OAUTH_SECRET=
# Scopes requested from Infomaniak (space or comma separated); defaults to the API scopes
# minus billing/account-security ones.
# INFOMANIAK_OAUTH_SCOPES=openid profile email accounts domain:read dns:read dns:write drive mail

# Set when running behind a reverse proxy (express "trust proxy" value), e.g. 1
# TRUST_PROXY=1

# Auth mode 1 (default): token passthrough. Still accepted alongside OAuth.
# Leave MCP_API_KEYS empty; each client sends its own Infomaniak API token as
#   Authorization: Bearer <infomaniak-token>

# Auth mode 2: API keys. Clients send Authorization: Bearer <one of these keys>
# and their Infomaniak token in X-Infomaniak-Token, or the server uses INFOMANIAK_API_TOKEN.
# MCP_API_KEYS=key-1,key-2
# INFOMANIAK_API_TOKEN=

# Hide the write tool (POST/PUT/PATCH/DELETE)
INFOMANIAK_READ_ONLY=false

# Host header allow-list (DNS rebinding protection), e.g. mcp.example.com
# MCP_ALLOWED_HOSTS=

# Truncate API responses beyond this many characters
MAX_RESPONSE_CHARS=60000
